#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE:0:1}" = "/" ] || SOURCE="$LINK_DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
# Not `python3 -m agentgrid`: -m puts the current directory first on
# sys.path, so running `ag` from inside another agentgrid checkout would run
# that checkout's code instead of this one. Pin this clone as sys.path[0]
# without changing directory -- `ag ticket` reads the cwd to find its project.
exec python3 -c 'import runpy, sys
sys.path[0] = sys.argv.pop(1)
sys.argv[0] = "ag"
runpy.run_module("agentgrid", run_name="__main__", alter_sys=True)' "$REPO" "$@"
