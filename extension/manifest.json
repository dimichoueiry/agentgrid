{
  "manifest_version": 3,
  "name": "AgentGrid Web Review",
  "version": "0.2.1",
  "description": "Press a hotkey on any localhost page to comment, mark up a screenshot, and release edits to an AgentGrid agent.",
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["capture.js", "bridge.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Toggle the AgentGrid review overlay on the current page"
    }
  },
  "action": {
    "default_title": "Toggle AgentGrid review overlay"
  }
}
